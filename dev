#!/usr/bin/env bash
# dev — primary entrypoint for development on the PROOF repo under Hermes.
#
# Usage:
#   ./dev              launch an interactive Hermes session (proof profile)
#   ./dev -q "prompt"  one-shot query (args pass straight through to hermes)
#   ./dev setup        bootstrap only: profile, project skills, trust
#   ./dev doctor       verify the environment without launching
#
# Idempotent: safe to run repeatedly. Never modifies ~/.hermes (default
# profile) — everything happens under the `proof` profile or this repo.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE="proof"

cd "$REPO_ROOT"

if ! command -v hermes >/dev/null 2>&1; then
  echo "error: hermes not on PATH (install: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash)" >&2
  exit 1
fi

profile_exists() {
  hermes profile list 2>/dev/null | grep -qE "^[│┃ ]*${PROFILE}( |$|…)" || \
    [ -d "$HOME/.hermes/profiles/${PROFILE}" ]
}

# Skills disabled in the proof profile — everything not relevant to
# this repo. Kept here so a fresh machine can rebuild the profile exactly.
build_disabled_list() {
  cat <<'JSON'
["agent-reach","ai-image-generation","animate","animate-expo","animation-vocabulary","apple-design","ask-sonner","claude-code","computer-use","codex","opencode","archify","architecture-diagram","ascii-video","baoyu-infographic","claude-design","design-md","humanizer","impeccable","manim-video","p5js","popular-web-designs","songwriting-and-ai-music","chezmoi-dotfiles","docker-nextjs","hermes-repo-devsetup","hermes-repo-profiles","nextjs-docker-env","omarchy-hyprland-config","omarchy-plugins","vercel-env-secrets","editor","emil-design-eng","find-animation-opportunities","flyai","improve-animations","market-competitor-research","gif-search","songsee","youtube-content","obsidian","airtable","box","document-to-action-items","docx","google-workspace","maps","meeting-action-items","notion","pdf","powerpoint","product-price-monitor","teams-meeting-pipeline","weekly-review-planning","xlsx","email-inbox-triage","himalaya","pick-ui-library","ratatui-tui","repo-scaffold","arxiv","competitor-news-monitor","grounded-citations","llm-wiki","review-animations","rust","scrollcraft","blocked-page-recovery","write-swift","supabase","supabase-postgres-best-practices","watch","xurl","dogfood","inspecting-hermes-desktop-dom","python-debugpy","remotion-best-practices","remotion-captions","remotion-create","remotion-docs","remotion-interactivity","remotion-maps","remotion-markup","remotion-multimedia","remotion-render","remotion-saas","remotion-studio","remotion-upgrade","apple-notes","apple-reminders","findmy","imessage","sandbox-next","sandbox-stable","sandbox-migrate-to-next","durable-objects","turnstile-spin","email-inbox-triage"]
JSON
}

ensure_profile() {
  if profile_exists; then
    return 0
  fi
  echo "[dev] creating '${PROFILE}' profile (cloned from default)..."
  hermes profile create "$PROFILE" --clone \
    --description "PROOF repo dev: Python/uv MLB projection system — lean skill set" >/dev/null
}

ensure_skill_prune() {
  # Already configured? (non-empty skills.disabled in the profile config)
  if hermes --profile "$PROFILE" config get skills.disabled 2>/dev/null \
      | grep -qvE '^(null|\[\]|\s*)?$'; then
    return 0
  fi
  echo "[dev] pruning irrelevant skills from '${PROFILE}' profile..."
  hermes --profile "$PROFILE" config set skills.disabled "$(build_disabled_list)" >/dev/null
}

ensure_hooks() {
  # Configure each hook list only when absent — never clobber hooks the
  # user added by hand. --force is safe here because the list was empty.
  local pre post prellm
  pre="$(hermes --profile "$PROFILE" config get hooks.pre_tool_call 2>/dev/null || true)"
  post="$(hermes --profile "$PROFILE" config get hooks.post_tool_call 2>/dev/null || true)"
  prellm="$(hermes --profile "$PROFILE" config get hooks.pre_llm_call 2>/dev/null || true)"
  echo "[dev] registering hook scripts in '${PROFILE}' profile..."
  [ "$(printf '%s' "$pre" | (grep -c proof- || true))" -gt 0 ] || \
  hermes --profile "$PROFILE" config set hooks.pre_tool_call \
    '[{"matcher":"terminal|execute_code","command":"~/.hermes/agent-hooks/proof-git-guard.sh","timeout":10,"fail_closed":true}]' --force >/dev/null
  [ "$(printf '%s' "$post" | (grep -c proof- || true))" -gt 0 ] || \
  hermes --profile "$PROFILE" config set hooks.post_tool_call \
    '[{"matcher":"write_file|patch","command":"~/.hermes/agent-hooks/proof-formatter.sh","timeout":15},{"matcher":"terminal","command":"~/.hermes/agent-hooks/proof-evidence.sh","timeout":10}]' --force >/dev/null
  [ "$(printf '%s' "$prellm" | (grep -c proof- || true))" -gt 0 ] || \
  hermes --profile "$PROFILE" config set hooks.pre_llm_call \
    '[{"command":"~/.hermes/agent-hooks/proof-inject-git-status.sh","timeout":5}]' --force >/dev/null
}

ensure_project_skills() {
  local missing=0
  # Skills linked into .hermes/skills (gitignored, per-machine).
  # Location is resolved dynamically — skills move between category dirs.
  local -a wanted=(test-driven-development systematic-debugging requesting-code-review \
               simplify-code spike codebase-inspection github grill-me \
               subagent-driven-development shell-portability empirical-mode-rollout \
               unlazy sqlite diagnosing-bugs)
  mkdir -p .hermes/skills
  local s t
  for s in "${wanted[@]}"; do
    # A real (non-symlink) directory would trap ln -sfn into nesting the
    # link inside it; remove that case first.
    if [ -d ".hermes/skills/$s" ] && [ ! -L ".hermes/skills/$s" ]; then
      echo "[dev] WARNING: .hermes/skills/$s is a real directory; leaving it alone" >&2
      continue
    fi
    [ -e ".hermes/skills/$s/SKILL.md" ] && continue
    # (find | cat | head) absorbs SIGPIPE so pipefail can't abort on 141.
    t="$(find -L "$HOME/.hermes/skills" -maxdepth 2 -type d -name "$s" 2>/dev/null | cat | head -1 || true)"
    if [ -n "$t" ]; then
      ln -sfn "$t" ".hermes/skills/$s"
      missing=1
    else
      echo "[dev] WARNING: skill '$s' not found in ~/.hermes/skills" >&2
    fi
  done
  # Repair broken links (skill moved between categories).
  for s in "${wanted[@]}"; do
    if [ -L ".hermes/skills/$s" ] && [ ! -e ".hermes/skills/$s/SKILL.md" ]; then
      t="$(find -L "$HOME/.hermes/skills" -maxdepth 2 -type d -name "$s" 2>/dev/null | cat | head -1 || true)"
      [ -n "$t" ] && ln -sfn "$t" ".hermes/skills/$s"
    fi
  done
  [ "$missing" -eq 1 ] && echo "[dev] bootstrapped .hermes/skills project links"
  return 0
}

ensure_trust() {
  # Trust is stored per-profile; only run when this repo isn't trusted yet.
  if ! hermes --profile "$PROFILE" skills trust . 2>&1 | grep -q "Already trusted"; then
    echo "[dev] trusted repo for project skills"
  fi
  return 0
}

doctor() {
  local fail=0
  if profile_exists; then
    echo "ok: profile '${PROFILE}' exists"
  else
    echo "MISSING: profile '${PROFILE}'"; fail=1
  fi
  if [ -d .hermes/skills ]; then
    local broken=0
    for d in .hermes/skills/*/; do
      [ -e "${d}SKILL.md" ] || { echo "BROKEN: ${d}"; broken=1; fail=1; }
    done
    [ "$broken" -eq 0 ] && echo "ok: project skills links ($(find .hermes/skills -maxdepth 1 -mindepth 1 | wc -l | tr -d ' ') skills)"
  else
    echo "MISSING: .hermes/skills"; fail=1
  fi
  local count
  count="$(hermes --profile "$PROFILE" skills trust . 2>&1 | (grep -oE '[0-9]+ project skill' || true) | (grep -oE '^[0-9]+' || true))"
  echo "ok: ${count:-0} project skill(s) load in this repo"
  hermes --profile "$PROFILE" skills list 2>&1 | { grep -c 'disabled' || true; } | xargs -I{} echo "ok: {} disabled skill(s) in profile"
  if hermes --profile "$PROFILE" config get hooks.pre_tool_call 2>/dev/null | grep -q 'git-guard'; then
    echo "ok: git-guard hook configured"
  else
    echo "MISSING: git-guard hook (profile config)"; fail=1
  fi
  local h
  for h in proof-git-guard.sh proof-evidence.sh proof-formatter.sh proof-inject-git-status.sh; do
    [ -x "$HOME/.hermes/agent-hooks/$h" ] || { echo "MISSING: hook script $h"; fail=1; }
  done
  [ "${fail:-0}" -eq 0 ] && echo "ok: all hook scripts executable"
  if command -v uv >/dev/null 2>&1; then
    echo "ok: uv ($(uv --version | awk '{print $2}'))"
  else
    echo "MISSING: uv (https://docs.astral.sh/uv/)"; fail=1
  fi
  [ -d .venv ] && echo "ok: .venv present" || echo "hint: run 'uv sync'"
  # Prune-guard: config get renders stored lists as YAML bullets or JSON.
  local disabled
  disabled="$(hermes --profile "$PROFILE" config get skills.disabled 2>/dev/null || true)"
  if printf '%s' "$disabled" | grep -qE '^( \* |- |\[)'; then
    echo "ok: skills.disabled is a stored list"
  else
    echo "MISSING: skills.disabled prune (got: $(printf '%s' "$disabled" | head -1))"; fail=1
  fi
  echo "note: hook allowlist is per-profile — first session start may prompt, or run: hermes --profile $PROFILE --accept-hooks (once)"
  return "$fail"
}

case "${1:-}" in
  setup)
    ensure_profile
    ensure_skill_prune
    ensure_hooks
    ensure_project_skills
    ensure_trust
    echo "[dev] setup complete"
    ;;
  doctor)
    ensure_profile 2>/dev/null || true
    doctor || exit 1
    ;;
  *)
    ensure_profile
    ensure_skill_prune
    ensure_hooks
    ensure_project_skills
    ensure_trust
    exec hermes --profile "$PROFILE" "$@"
    ;;
esac
